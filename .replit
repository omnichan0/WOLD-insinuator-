# OMEGA-8D Replit configuration
run = "bash start.sh"
entrypoint = "start.sh"
modules = ["nodejs-24", "python-base-3.13"]

[nix]
lang = "bash"
packages = ["cmakeMinimal"]
channel = "stable-25_05"

[env]
PORT = "5000"
OMEGA8D_AI_PORT = "8081"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
OMEGA8D_ADMIN_OWNER_EMAIL = "lovethayo2017@gmail.com"
